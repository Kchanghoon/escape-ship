--- !u!114 &2143152587904305592
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8052436877337705240}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cc928a5ca5f4b0842a4ea7e6c0b94138, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueUI: {fileID: 0}
  dialogues:
  - "\uC774 \uC55E\uC758 \uBB38\uC740 \uB9C8\uC2A4\uD130\uD0A4, \uADF8\uB7EC\uB2C8\uAE4C
    \uD568\uC7A5\uB2D8 \uCE74\uB4DC\uB85C\uB9CC \uC5F4\uB9B0\uB370\uC694! "
  - "\uB2E4\uD589\uD788 \uC606 \uCEF4\uD4E8\uD130\uC5D0\uC11C 1\uAE09 \uBCF4\uC548\uCE74\uB4DC\uC640
    \uC815\uBCF4 \uB514\uC2A4\uD06C\uB97C \uAC00\uC838\uC624\uBA74 \uD568\uC7A5 \uCE74\uB4DC\uB97C
    \uBC1C\uAE09\uD574\uC8FC\uB294 \uC2DC\uC2A4\uD15C\uC774 \uC0B4\uC544\uC788\uC5B4\uC694."
  - "\uC74C.. \uADFC\uB370 \uC7A0\uC2DC\uB9CC\uC694 \uC5B4\uB77C? \uCE74\uB4DC\uB97C
    \uC5C5\uADF8\uB808\uC774\uB4DC \uD560\uB824\uBA74 2\uCE35 \uBC15\uC2A4\uB4E4\uC758
    \uBE44\uBC00\uBC88\uD638\uB97C \uD480\uB77C\uB294\uB370\uC694?"
  - "\uAC01 \uBC15\uC2A4\uB4E4\uC758 \uBE44\uBC00\uBC88\uD638\uB294 \uBC15\uC2A4\uB4E4\uC758
    \uBE5B\uACFC \uB9E4\uCE58\uD558\uB294 \uD30C\uC774\uD504\uC758 \uAC1C\uC218\uB798\uC694.
    \uC774\uAC70 1\uCE35 2\uCE35\uC5D0\uC11C \uB9CE\uC774 \uBCF4\uC774\uC9C0 \uC54A\uC558\uB098\uC694?
    \uC5BC\uB978 \uC138\uB7EC \uAC00\uBCF4\uC8E0!"
  isTimeStopped: 1
  playerTag: Player
  interactionDistance: 3
  dialogueText: {fileID: 0}
