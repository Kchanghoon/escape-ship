      m_Calls: []
  m_text: "\uC624\uB978\uCABD \uC704\uC758 \uAC8C\uC774\uC9C0\uB294 \uAC01\uAC01
    \uC0B0\uC18C, \uC2A4\uD2B8\uB808\uC2A4 \uC9C0\uC218\uC785\uB2C8\uB2E4. \n\uC0B0\uC18C\uB294
    \uCD08\uB2F9 1\uC529 \uAC10\uC18C\uD558\uBA70 \uB2EC\uB9AC\uAE30,\uB6F0\uAE30
    \uB4F1\uC744 \uD560 \uACBD\uC6B0 \uB354 \uB9CE\uC740 \uC0B0\uC18C\uAC00 \uAC10\uC18C\uB418\uAC8C
    \uB429\uB2C8\uB2E4.\n\uC2E0\uC18C\uAC00 \uBAA8\uB450 \uAC10\uC18C\uB420 \uACBD\uC6B0
    \uC2A4\uD2B8\uB808\uC2A4 \uC9C0\uC218\uAC00 \uBE60\uB974\uAC8C \uC0C1\uC2B9\uD558\uAC8C
    \uB429\uB2C8\uB2E4.\n\uC0B0\uC18C\uB294 \uD68C\uBCF5\uAD6C\uC5ED\uC744 \uD1B5\uD574
    \uCDA9\uC804\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \n\uC2A4\uD2B8\uB808\uC2A4
    \uC9C0\uC218\uB294 E\uD0A4\uB97C \uB20C\uB7EC \uC5B4\uB5A4 \uD589\uB3D9\uC744
    \uD560 \uB54C\uB9C8\uB2E4 5\uC529 \uC0C1\uC2B9\uD569\uB2C8\uB2E4. \n\uC2A4\uD2B8\uB808\uC2A4
    \uC9C0\uC218\uAC00 100\uC774 \uB420 \uACBD\uC6B0 \uC989\uC2DC \uAC8C\uC784\uC740
    \uC2E4\uD328\uD558\uBA70 \uCC98\uC74C\uBD80\uD130 \uB2E4\uC2DC \uB3C4\uC804\uD558\uC154\uC57C
    \uD558\uB2C8 \uC2A4\uD2B8\uB808\uC2A4\uC640 \uC0B0\uC18C \uC9C0\uC218\uC5D0 \uC8FC\uC758\uB97C
    \uAE30\uC6B8\uC5EC \uC8FC\uC138\uC694 "
