  dialogueUI: {fileID: 0}
  dialogues:
  - "\uC774 \uC55E \uBC29\uC740 \uB808\uC774\uC800 \uBC29\uC774\uB798\uC694! \uB808\uC774\uC800\uB97C
    \uC2DC\uC791\uC9C0\uC810\uC5D0\uC11C \uBAA9\uD45C\uC9C0\uC810\uAE4C\uC9C0 \uAC70\uC6B8\uC744
