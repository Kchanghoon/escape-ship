--- !u!114 &7622979824159636464
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2073402312566887118}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cc928a5ca5f4b0842a4ea7e6c0b94138, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueUI: {fileID: 0}
  dialogues:
  - "\uC557 \uC815\uC2E0\uC774 \uB4DC\uC138\uC694?"
  - "\uD070\uC77C\uC774\uC5D0\uC694! \uC9C0\uAE08 \uC6B0\uC8FC\uC120\uC5D0 \uBB3C\uB9AC\uC801
    \uCDA9\uB3CC\uC774 \uC0DD\uACA8\uC11C \uAE30\uCCB4\uAC00 \uC774\uC0C1\uD574\uC838\uAC00\uC694!"
  - "\uBE44\uC0C1 \uACA9\uB0A9\uACE0\uC5D0 \uC544\uB9C8 \uBE44\uC0C1\uC6A9 \uD0C8\uCD9C\uC120\uC774
    \uC788\uC744\uAC70\uC5D0\uC694."
  - "\uD544\uC694\uD55C \uAC83\uB4E4\uC744 \uCC59\uACA8\uC57C\uD574\uC694! \uC544\uCC38
    \uC5EC\uAE30 \uBE44\uBC00\uBC88\uD638\uB294 \uC800\uBC88\uC5D0 \uCC45\uC5D0\uB2E4\uAC00
    \uAE30\uB85D\uD574 \uB450\uC168\uB358\uAC78 \uBD24\uC5B4\uC694! \uC8FC\uC704\uB97C
    \uB458\uB7EC\uBCF4\uACE0 \uC5BC\uB978 \uAC00\uC8E0!"
  - "\uC5B4\uC11C \uBE44\uC0C1 \uACA9\uB0A9\uACE0\uB85C \uAC00\uC8E0! \uC2DC\uAC04\uC774
    \uBCC4\uB85C \uC5C6\uC5B4\uC694!"
  isTimeStopped: 1
  playerTag: Player
  interactionDistance: 1
  dialogueText: {fileID: 0}
