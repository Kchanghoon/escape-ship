--- !u!114 &4102208126718302181
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 396871740073558417}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0797b1e3289d9ef4aaf632fb5961b394, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 0}
  dialogueText: {fileID: 0}
  dialogues:
  - "\uD604\uC7AC \uBC29\uC740 \uD3D0\uC1E0\uB41C \uC0C1\uD0DC\uC785\uB2C8\uB2E4.
    \uB2E4\uD589\uD788 \uC544\uC9C1 \uC0B0\uC18C \uB18D\uB3C4\uB294 \uB5A8\uC5B4\uC9C0\uC9C0
    \uC54A\uACE0 \uC788\uC73C\uBA70 \uD0A4\uD328\uB4DC\uC758 \uC7A0\uAE08\uBC88\uD638\uB97C
    \uD574\uCCB4\uD558\uC2DC\uBA74 \uB098\uAC00\uC2E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uD574\uB2F9 \uD0A4\uD328\uB4DC\uC758 \uBE44\uBC00\uBC88\uD638\uB294 \uD568\uC7A5\uB2D8\uC774
    \uC804\uC5D0 \uC774 \uBC29 \uC548\uC5D0 \uAFB8\uBA70\uB193\uC73C\uC168\uB358
    \uAC83\uC73C\uB85C \uAE30\uC5B5\uD569\uB2C8\uB2E4."
  - "\uD0A4\uD328\uB4DC \uAE30\uC900\uC73C\uB85C \uC704, \uC67C\uCABD, \uC544\uB798,
    \uC624\uB978\uCABD \uC774 \uC21C\uC11C\uB97C \uAE30\uC5B5\uD558\uB77C\uACE0 \uD558\uC168\uC2B5\uB2C8\uB2E4."
  - "\uC544\uCC38 \uC544\uC774\uD15C\uC744 \uC8FC\uC6B0\uC2DC\uB824\uBA74 \uD654\uBA74\uC758
    \uC911\uC559\uC5D0 \uB9DE\uCD98 \uD6C4 \uB9C8\uC6B0\uC2A4 \uC88C\uD074\uB9AD\uC744
    \uB20C\uB7EC\uC8FC\uC138\uC694. \uC790\uC138\uD55C \uC0AC\uD56D\uC740 \uC5EC\uAE30
    \uC774 \uCC45\uC744 \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
  interactionDistance: 5
  TalktoText: {fileID: 0}
